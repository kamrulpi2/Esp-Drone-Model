#include <Wire.h>
#include <MPU6050.h>

MPU6050 mpu;

float roll=0;
float pitch=0;

float gxOffset=0;
float gyOffset=0;

unsigned long lastTime;


void setup()
{
 Serial.begin(115200);

 Wire.begin(21,22);

 mpu.initialize();

 delay(1000);


 long gx=0,gy=0;

 for(int i=0;i<1000;i++)
 {
  int16_t ax,ay,az,gx1,gy1,gz1;

  mpu.getMotion6(&ax,&ay,&az,&gx1,&gy1,&gz1);

  gx+=gx1;
  gy+=gy1;

  delay(2);
 }

 gxOffset=gx/1000.0;
 gyOffset=gy/1000.0;


 lastTime=micros();

 Serial.println("READY");
}



void loop()
{

int16_t ax,ay,az,gx,gy,gz;

mpu.getMotion6(&ax,&ay,&az,&gx,&gy,&gz);


float accX=ax/16384.0;
float accY=ay/16384.0;
float accZ=az/16384.0;


float rollAcc=atan2(accY,accZ)*57.3;
float pitchAcc=atan2(-accX,sqrt(accY*accY+accZ*accZ))*57.3;


float dt=(micros()-lastTime)/1000000.0;
lastTime=micros();


float gyroX=(gx-gxOffset)/131.0;
float gyroY=(gy-gyOffset)/131.0;


roll=0.96*(roll+gyroX*dt)+0.04*rollAcc;
pitch=0.96*(pitch+gyroY*dt)+0.04*pitchAcc;


Serial.print("Roll:");
Serial.print(roll);

Serial.print(" Pitch:");
Serial.println(pitch);


delay(20);

}
