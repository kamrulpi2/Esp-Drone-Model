void setup() {
  Serial.begin(115200);
  delay(500);

  // Safe motor init
  for (int p : {MOTOR_FL_PIN, MOTOR_FR_PIN, MOTOR_BL_PIN, MOTOR_BR_PIN}) {
    pinMode(p, OUTPUT);
    digitalWrite(p, LOW);
  }
  motorInit();

  pinMode(INT_PIN, INPUT);

  // ─── IMU Init (MPU6500 compatible) ───
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  delay(100);

  mpu.initialize();
  delay(50);

  mpu.setSleepEnabled(false);
  mpu.setClockSource(MPU6050_CLOCK_PLL_XGYRO);
  mpu.setFullScaleGyroRange(MPU6050_GYRO_FS_250);
  mpu.setFullScaleAccelRange(MPU6050_ACCEL_FS_2);
  delay(50);

  uint8_t who = mpu.getDeviceID();
  Serial.print("WHO_AM_I: 0x");
  Serial.println(who, HEX);

  if (who == 0x68 || who == 0x70 || who == 0x71 || who == 0x38 ) {
    imuOk = true;
    Serial.println("IMU OK (MPU6050/6500 detected)");
    calibrateGyro();
  } else {
    imuOk = false;
    Serial.println("IMU FAIL - Unknown device");
  }

  // ─── WiFi AP ───
  WiFi.mode(WIFI_AP);
  delay(100);

  bool apStarted = WiFi.softAP(WIFI_SSID, WIFI_PASSWORD, 1, 0, 4);  // channel 1

  if (apStarted) {
    Serial.println("SoftAP started successfully!");
    Serial.print("SSID: ");
    Serial.println(WIFI_SSID);
    Serial.print("Password: ");
    Serial.println(WIFI_PASSWORD);
    Serial.print("IP Address: http://");
    Serial.println(WiFi.softAPIP());
  } else {
    Serial.println("SoftAP FAILED to start!");
  }

  server.on("/",          HTTP_GET,  handleRoot);
  server.on("/cmd",       HTTP_POST, handleCmd);
  server.on("/pid",       HTTP_POST, handlePID);
  server.on("/freqs",     HTTP_POST, handleFreqs);
  server.on("/calibrate", HTTP_POST, handleCalibrate);
  server.on("/telemetry", HTTP_GET,  handleTelemetry);
  server.begin();

  lastLoopUs = micros();
}

// ─────────────────────────────────────
void loop() {
  server.handleClient();

  if (calibrating) return;

  float dt = (micros() - lastLoopUs) / 1e6f;
  lastLoopUs = micros();
  if (dt <= 0 || dt > 0.1f) dt = 0.01f;

  if (imuOk) readIMU(dt);

  // Watchdog: disarm if no command for 1.5 s
  if (millis() - lastCmdMs > 1500 && lastCmdMs != 0) {
    cmd.armed = false;
  }

  if (!cmd.armed || cmd.throttle < 0.05f) {
    motorsOff();
    return;
  }

  // Manual override mode
  if (manualMode) {
    setMotors(manualDuty[0], manualDuty[1], manualDuty[2], manualDuty[3]);
    return;
  }

  // PID flight mode
  int base = MOTOR_MIN_DUTY + (int)(cmd.throttle * (PWM_MAX - MOTOR_MIN_DUTY));

  float setR = cmd.roll  * 30.0f;
  float setP = cmd.pitch * 30.0f;

  float errR = setR - angleRoll;
  float errP = setP - anglePitch;

  integRoll  += errR * dt;
  integPitch += errP * dt;
  integRoll  = constrain(integRoll,  -200.0f, 200.0f);
  integPitch = constrain(integPitch, -200.0f, 200.0f);

  float dR = (errR - prevErrRoll)  / dt;
  float dP = (errP - prevErrPitch) / dt;

  float pidR = Kp * errR + Ki * integRoll  + Kd * dR;
  float pidP = Kp * errP + Ki * integPitch + Kd * dP;

  prevErrRoll  = errR;
  prevErrPitch = errP;

  // Motor mixing (X-quad)
  setMotors(
    base - (int)pidR + (int)pidP,
    base + (int)pidR + (int)pidP,
    base - (int)pidR - (int)pidP,
    base + (int)pidR - (int)pidP
  );
}
