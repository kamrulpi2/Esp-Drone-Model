// ─── HTTP Handlers ────────────────────

void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleCmd() {
  StaticJsonDocument<256> doc;
  if (deserializeJson(doc, server.arg("plain")) != DeserializationError::Ok) {
    server.send(400, "text/plain", "bad json"); return;
  }
  cmd.armed    = doc["armed"]    | false;
  cmd.throttle = doc["throttle"] | 0.0f;
  cmd.roll     = doc["roll"]     | 0.0f;
  cmd.pitch    = doc["pitch"]    | 0.0f;
  cmd.yaw      = doc["yaw"]      | 0.0f;

  bool manual  = doc["manual"]   | false;
  manualMode   = manual;
  if (manual) {
    manualDuty[0] = doc["m1"] | 0;
    manualDuty[1] = doc["m2"] | 0;
    manualDuty[2] = doc["m3"] | 0;
    manualDuty[3] = doc["m4"] | 0;
  }
  lastCmdMs = millis();
  server.send(200, "text/plain", "ok");
}

void handlePID() {
  StaticJsonDocument<128> doc;
  deserializeJson(doc, server.arg("plain"));
  Kp = doc["kp"] | Kp;
  Ki = doc["ki"] | Ki;
  Kd = doc["kd"] | Kd;
  server.send(200, "text/plain", "ok");
}

void handleFreqs() {
  StaticJsonDocument<128> doc;
  deserializeJson(doc, server.arg("plain"));
  if (doc.containsKey("fl")) setMotorFreq(0, (uint32_t)(doc["fl"] | 20000));
  if (doc.containsKey("fr")) setMotorFreq(1, (uint32_t)(doc["fr"] | 20000));
  if (doc.containsKey("bl")) setMotorFreq(2, (uint32_t)(doc["bl"] | 20000));
  if (doc.containsKey("br")) setMotorFreq(3, (uint32_t)(doc["br"] | 20000));
  server.send(200, "text/plain", "ok");
}

void handleCalibrate() {
  calibrateGyro();
  server.send(200, "text/plain", "ok");
}

void handleTelemetry() {
  StaticJsonDocument<128> doc;
  doc["roll"]  = angleRoll;
  doc["pitch"] = anglePitch;
  doc["yaw"]   = angleYaw;
  doc["imu"]   = imuOk;
  JsonArray m = doc.createNestedArray("m");
  m.add(motorDuty[0]); m.add(motorDuty[1]);
  m.add(motorDuty[2]); m.add(motorDuty[3]);
  String out;
  serializeJson(doc, out);
  server.send(200, "application/json", out); 
}

