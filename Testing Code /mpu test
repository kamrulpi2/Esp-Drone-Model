// ─────────────────────────────────────
void motorInit() {
  int pins[4] = {MOTOR_FL_PIN, MOTOR_FR_PIN, MOTOR_BL_PIN, MOTOR_BR_PIN};
  for (int i = 0; i < 4; i++) {
    pinMode(pins[i], OUTPUT);
    digitalWrite(pins[i], LOW);

    ledcSetup(motorChannels[i], motorFreq[i], PWM_RES);
    ledcAttachPin(pins[i], motorChannels[i]);
    ledcWrite(motorChannels[i], 0);
  }
}

void motorsOff() {
  for (int i = 0; i < 4; i++) motorDuty[i] = 0;
  ledcWrite(motorChannels[0], 0);
  ledcWrite(motorChannels[1], 0);
  ledcWrite(motorChannels[2], 0);
  ledcWrite(motorChannels[3], 0);
}

void setMotorFreq(int idx, uint32_t freq) {
  int pins[4] = {MOTOR_FL_PIN, MOTOR_FR_PIN, MOTOR_BL_PIN, MOTOR_BR_PIN};
  motorFreq[idx] = freq;

  ledcDetachPin(pins[idx]);
  ledcSetup(motorChannels[idx], freq, PWM_RES);
  ledcAttachPin(pins[idx], motorChannels[idx]);
  ledcWrite(motorChannels[idx], 0);
}

void setMotors(int fl, int fr, int bl, int br) {
  fl = constrain(fl, 0, PWM_MAX);
  fr = constrain(fr, 0, PWM_MAX);
  bl = constrain(bl, 0, PWM_MAX);
  br = constrain(br, 0, PWM_MAX);

  ledcWrite(motorChannels[0], fl);
  ledcWrite(motorChannels[1], fr);
  ledcWrite(motorChannels[2], bl);
  ledcWrite(motorChannels[3], br);

  motorDuty[0] = fl; motorDuty[1] = fr;
  motorDuty[2] = bl; motorDuty[3] = br;
}

// ─────────────────────────────────────
void readIMU(float dt) {
  int16_t ax, ay, az, gx, gy, gz;
  mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);
  float accX = ax / 16384.0f;
  float accY = ay / 16384.0f;
  float accZ = az / 16384.0f;
  float gyrX = (gx / 131.0f) - gyroX_offset;
  float gyrY = (gy / 131.0f) - gyroY_offset;
  gyrZ       = (gz / 131.0f) - gyroZ_offset;
  float rollAcc  = atan2f(accY, accZ) * 57.3f;
  float pitchAcc = atan2f(-accX, sqrtf(accY*accY + accZ*accZ)) * 57.3f;
  angleRoll  = 0.96f * (angleRoll  + gyrX * dt) + 0.04f * rollAcc;
  anglePitch = 0.96f * (anglePitch + gyrY * dt) + 0.04f * pitchAcc;
  angleYaw  += gyrZ * dt;
}

// ─────────────────────────────────────
void calibrateGyro() {
  calibrating = true;
  motorsOff();
  Serial.println("Calibrating — keep drone STILL...");
  long sx = 0, sy = 0, sz = 0;
  for (int i = 0; i < 1000; i++) {
    int16_t ax, ay, az, gx, gy, gz;
    mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);
    sx += gx; sy += gy; sz += gz;
    delay(2);
  }
  gyroX_offset = (sx / 1000.0f) / 131.0f;
  gyroY_offset = (sy / 1000.0f) / 131.0f;
  gyroZ_offset = (sz / 1000.0f) / 131.0f;
  integRoll = integPitch = 0;
  prevErrRoll = prevErrPitch = 0;
  angleRoll = anglePitch = angleYaw = 0;
  calibrating = false;
  Serial.println("Calibration done.");
}

