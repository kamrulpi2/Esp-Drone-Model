#define MOTOR_FR_PIN 33
#define MOTOR_BL_PIN 32
#define MOTOR_BR_PIN 25

// ─── IMU ──────────────────────────────
#define SDA_PIN 22
#define SCL_PIN 21
#define INT_PIN 14

// ─── PWM DEFAULTS ─────────────────────
#define PWM_RES       10
#define PWM_MAX       1023
#define MOTOR_MIN_DUTY 150

// ─── Objects ──────────────────────────
MPU6050 mpu;
WebServer server(80);

// ─── Per-motor PWM frequency & channels ──
uint32_t motorFreq[4] = {20000, 20000, 20000, 20000};
const int motorChannels[4] = {0, 1, 2, 3};

// ─── Flight Command ───────────────────
struct FlightCmd {
  float throttle = 0, roll = 0, pitch = 0, yaw = 0;
  bool armed = false;
} cmd;

// ─── Manual motor override ────────────
